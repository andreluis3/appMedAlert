<!--
    Android 11 e anterior (full-backup-content).
    O MedAlert guarda token de sessão (DataStore, em files/datastore) e dados de saúde
    (Room, em databases/) no aparelho. NADA disso deve ir para o backup em nuvem:
    o servidor é a fonte oficial dos medicamentos e o login é refeito ao restaurar.
 -->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="."/>
</full-backup-content>